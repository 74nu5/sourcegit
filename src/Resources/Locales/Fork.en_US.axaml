<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Strings added by this fork, kept out of the upstream locale files so that the
    hundred-odd commits a year they receive never collide with ours. Merged after
    the active locale in App.SetLocale, so these entries win.

    A key missing from a translation falls back to the English one below it, which
    is the same behaviour the upstream files have between themselves.
  -->
  <x:String x:Key="Text.Histories.Header.Branch" xml:space="preserve">BRANCH / TAG</x:String>
  <x:String x:Key="Text.Histories.Header.Graph" xml:space="preserve">GRAPH</x:String>
  <x:String x:Key="Text.Histories.Header.Subject" xml:space="preserve">COMMIT MESSAGE</x:String>
  <x:String x:Key="Text.Histories.HiddenLanes.Tip" xml:space="preserve">Some branches share the last column because the graph reached its lane budget. Widen the window or use the compact placement to see more.</x:String>
  <x:String x:Key="Text.PullRequest.State.Open" xml:space="preserve">OPEN</x:String>
  <x:String x:Key="Text.PullRequest.State.Draft" xml:space="preserve">DRAFT</x:String>
  <x:String x:Key="Text.PullRequest.State.Merged" xml:space="preserve">MERGED</x:String>
  <x:String x:Key="Text.PullRequest.State.Closed" xml:space="preserve">CLOSED</x:String>
  <x:String x:Key="Text.PullRequest.OpenInBrowser" xml:space="preserve">Click to open it in your browser</x:String>
  <x:String x:Key="Text.Preferences.Forge" xml:space="preserve">FORGES</x:String>
  <x:String x:Key="Text.Preferences.Forge.Empty" xml:space="preserve">No account selected. Use + to add one, choosing the forge it talks to.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Url" xml:space="preserve">Address</x:String>
  <x:String x:Key="Text.Preferences.Forge.Url.Hint" xml:space="preserve">Where the forge lives. Change it for a self-hosted instance, a GitHub Enterprise server or an on-premises Azure DevOps Server.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Organization" xml:space="preserve">Organisation</x:String>
  <x:String x:Key="Text.Preferences.Forge.Organization.Watermark" xml:space="preserve">every organisation on this address</x:String>
  <x:String x:Key="Text.Preferences.Forge.Organization.Hint" xml:space="preserve">The organisation on Azure DevOps, the owner or organisation on GitHub, the group on GitLab. Leave it empty and the account serves every repository hosted at the address above.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Project" xml:space="preserve">Project</x:String>
  <x:String x:Key="Text.Preferences.Forge.Project.Watermark" xml:space="preserve">every project of the organisation</x:String>
  <x:String x:Key="Text.Preferences.Forge.Project.Hint" xml:space="preserve">Azure DevOps files repositories under organisation / project / repository. Naming one restricts this account to it, which is what a token scoped to a single project needs. The narrowest account that fits a repository is the one used.</x:String>
  <x:String x:Key="Text.Preferences.Forge.FromEnv" xml:space="preserve">Read the token from an environment variable</x:String>
  <x:String x:Key="Text.Preferences.Forge.ShowIndicator" xml:space="preserve">Mark branches that have an open pull request</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test" xml:space="preserve">Test connection</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.Hint" xml:space="preserve">Sends one authenticated request and reports what came back. It proves the address is reachable and the token is accepted; on Azure DevOps it also proves the organisation and project named above are the ones the token opens.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.Running" xml:space="preserve">Asking…</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.Cancelled" xml:space="preserve">Test abandoned.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.Ok" xml:space="preserve">Connected.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.NoToken" xml:space="preserve">No token to send.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.NeedsOrganization" xml:space="preserve">Azure DevOps has nothing to answer without an organisation.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.BadAddress" xml:space="preserve">That address is not a usable http or https address.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.Unauthorized" xml:space="preserve">The token was refused. It may be wrong, expired, or issued for another organisation.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.Forbidden" xml:space="preserve">The token was accepted but is not allowed to read this.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.NotFound" xml:space="preserve">Nothing at that address. Check the organisation and project names.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.Unreachable" xml:space="preserve">Could not reach the forge.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.Timeout" xml:space="preserve">No answer within fifteen seconds.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Test.Unexpected" xml:space="preserve">Unexpected answer.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Token" xml:space="preserve">Token</x:String>
  <x:String x:Key="Text.Preferences.Forge.Token.Hint" xml:space="preserve">With the box above ticked, the name of the variable holding the token (e.g. AZURE_DEVOPS_PAT). Unticked, the token itself.</x:String>
  <x:String x:Key="Text.Preferences.Forge.Privacy" xml:space="preserve">Preferences are stored as plain text, so a token typed here is readable by anything that can read your home directory. Naming an environment variable keeps it out of the file.</x:String>
  <x:String x:Key="Text.Repository.BranchPlacement" xml:space="preserve">BRANCH PLACEMENT</x:String>
  <x:String x:Key="Text.Repository.BranchPlacement.Compact" xml:space="preserve">Compact</x:String>
  <x:String x:Key="Text.Repository.BranchPlacement.Stable" xml:space="preserve">Stable Lanes</x:String>
  <x:String x:Key="Text.Repository.HistoriesColumns" xml:space="preserve">COLUMNS</x:String>
  <x:String x:Key="Text.Repository.HistoriesColumns.AllRows" xml:space="preserve">Branch Column: All Rows</x:String>
  <x:String x:Key="Text.Repository.HistoriesColumns.ColorizeRows" xml:space="preserve">Colorize Rows By Branch</x:String>
  <x:String x:Key="Text.Repository.HistoriesColumns.RefsOnly" xml:space="preserve">Branch Column: Refs Only</x:String>
  <x:String x:Key="Text.Repository.HistoriesColumns.RemoteIcon" xml:space="preserve">Remote As Icon Instead Of Name</x:String>
  <x:String x:Key="Text.Repository.HistoriesColumns.ShowBranch" xml:space="preserve">Branch / Tag Column</x:String>
  <x:String x:Key="Text.Repository.HistoriesColumns.SplitGraph" xml:space="preserve">Separate Graph Column</x:String>
</ResourceDictionary>
