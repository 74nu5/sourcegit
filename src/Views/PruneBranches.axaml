<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
                    x:Class="SourceGit.Views.PruneBranches"
                    x:DataType="vm:PruneBranches"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.Prune}"
                    Width="900" Height="620"
                    MinWidth="560" MinHeight="380"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <v:ChromelessWindow.Styles>
    <!-- Pas de convertisseur : deux classes suffisent, et rien d'amont n'est touche. -->
    <Style Selector="TextBlock.state">
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="TextBlock.state.warning">
      <Setter Property="Foreground" Value="#FFE5534B"/>
    </Style>
    <Style Selector="TextBlock.branch.locked">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <!-- Ce qui part doit se voir sans compter les cases. -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="Border.row.picked">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Opacity" Value="0.16"/>
    </Style>
  </v:ChromelessWindow.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Clear}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.Prune}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- BODY -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="12,8,12,12">
      <TextBlock Grid.Row="0"
                 Margin="0,0,0,8"
                 Text="{DynamicResource Text.Prune.Tip}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.FG2}"
                 FontStyle="Italic"/>

      <Border Grid.Row="1"
              Background="{DynamicResource Brush.Contents}"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border1}"
              CornerRadius="3">
        <Grid>
          <!-- Pendant l'elagage : rien a cocher, et on dit pourquoi. -->
          <TextBlock Text="{DynamicResource Text.Prune.Pruning}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.FG2}"
                     IsVisible="{Binding IsLoading}"/>

          <ListBox Background="Transparent"
                   ItemsSource="{Binding Items}"
                   SelectionMode="Single"
                   IsVisible="{Binding !IsLoading}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="6,2"/>
              </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:PrunableBranch">
                <Grid>
                  <!-- Le fond de la ligne cochee, sous le contenu pour ne rien delaver. -->
                  <Border Classes="row" Classes.picked="{Binding IsSelected}"/>

                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Height="24" Margin="2,0">
                  <CheckBox Grid.Column="0"
                            Margin="0,0,8,0"
                            MinWidth="0"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            IsEnabled="{Binding !IsLocked}"/>

                  <!-- La colonne qui compte : elle prend tout ce que la fenetre donne,
                       et la fenetre s'agrandit. -->
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Name}"
                             Classes="branch"
                             Classes.locked="{Binding IsLocked}"/>

                  <!-- L'avertissement se dit A COTE de l'etat, jamais a sa place :
                       "morte ET non fusionnee" est precisement ce qu'on arbitre. -->
                  <TextBlock Grid.Column="2"
                             Margin="12,0,0,0"
                             FontSize="11"
                             VerticalAlignment="Center"
                             TextAlignment="Right"
                             Text="{Binding Warning}"
                             Classes="state warning"/>

                  <TextBlock Grid.Column="3"
                             Margin="10,0"
                             MinWidth="104"
                             FontSize="11"
                             VerticalAlignment="Center"
                             TextAlignment="Right"
                             Text="{Binding State}"
                             Classes="state"/>

                  <TextBlock Grid.Column="4"
                             MinWidth="92"
                             FontSize="11"
                             VerticalAlignment="Center"
                             TextAlignment="Right"
                             Text="{Binding Age}"
                             Foreground="{DynamicResource Brush.FG2}"/>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <TextBlock Grid.Row="2"
                 Margin="2,8,0,0"
                 FontSize="11"
                 Text="{Binding Summary}"
                 Foreground="{DynamicResource Brush.FG2}"/>

      <StackPanel Grid.Row="3" Orientation="Vertical" Margin="2,8,0,0">
        <CheckBox Content="{DynamicResource Text.Prune.IncludeNeverPushed}"
                  IsChecked="{Binding IncludeNeverPushed, Mode=TwoWay}"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <CheckBox VerticalAlignment="Center"
                    Content="{DynamicResource Text.Prune.IncludeOldGone}"
                    IsChecked="{Binding IncludeOldGone, Mode=TwoWay}"/>
          <ComboBox Margin="6,0,0,0"
                    Width="72"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding IncludeOldGone}"
                    ItemsSource="{Binding Source={x:Static vm:PruneBranches.MonthChoices}}"
                    SelectedItem="{Binding OldGoneMonths, Mode=TwoWay}"/>
          <TextBlock Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     Text="{DynamicResource Text.Prune.Months}"
                     Foreground="{DynamicResource Brush.FG2}"/>
        </StackPanel>

        <CheckBox Margin="0,4,0,0"
                  Content="{DynamicResource Text.Prune.Force}"
                  IsChecked="{Binding Force, Mode=TwoWay}"/>
      </StackPanel>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Classes="flat primary"
                MinWidth="88"
                Content="{DynamicResource Text.Prune.Delete}"
                IsEnabled="{Binding !IsLoading}"
                Click="OnDelete"/>
        <Button Classes="flat"
                Margin="8,0,0,0"
                MinWidth="88"
                Content="{DynamicResource Text.Cancel}"
                Click="OnCancel"/>
      </StackPanel>
    </Grid>
  </Grid>
</v:ChromelessWindow>
